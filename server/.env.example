# Server Port
PORT=5000

# CORS Allowed Client URL (optional, in addition to localhost defaults)
CLIENT_URL=http://localhost:5173

# SMTP Configuration for sending email enquiries
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password_here

# Recipient Email for enquiries
RECEIVER_EMAIL=info@statscientific.com
